# United Domains production routing. GitHub Pages ignores this file.
RewriteEngine On
# Retired English pages have equivalent German successors. Keep unknown URLs as 404.
RewriteRule ^en/?$ https://psoydo.com/de/ [R=301,L]
RewriteRule ^en/index\.html$ https://psoydo.com/de/ [R=301,L]
RewriteRule ^en/(datenschutz|impressum)\.html$ https://psoydo.com/de/$1.html [R=301,L]
# Root and explicit index aliases go straight to the canonical content URL.
RewriteRule ^(?:index\.html)?$ https://psoydo.com/de/ [R=301,L]
RewriteRule ^de$ https://psoydo.com/de/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+de/index\.html[?\s] [NC]
RewriteRule ^de/index\.html$ https://psoydo.com/de/ [R=301,L]
# Preserve paths and query strings when normalizing the www hostname.
RewriteCond %{HTTP_HOST} ^www\.psoydo\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://psoydo.com%{REQUEST_URI} [R=301,L,NE]
# HTTPS is enforced by the hosting proxy; avoid a second proxy-dependent rule.
ErrorDocument 404 /404.html

# BEGIN PSOYDO SECURITY
Options -Indexes
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
<FilesMatch "(^\\.|\\.(env|ini|log|sql|bak|old|orig|swp)$)">
Require all denied
</FilesMatch>
# END PSOYDO SECURITY
